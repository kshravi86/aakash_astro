<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/background_gradient_start"
                android:centerColor="@color/background_gradient_mid"
                android:endColor="@color/background_gradient_end"
                android:type="linear" />
        </shape>
    </item>

    <item android:gravity="top|end">
        <shape android:shape="oval">
            <size
                android:width="340dp"
                android:height="340dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="190dp"
                android:startColor="@color/glow_violet"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>

    <item
        android:gravity="bottom|start"
        android:top="240dp">
        <shape android:shape="oval">
            <size
                android:width="300dp"
                android:height="300dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="180dp"
                android:startColor="@color/glow_teal"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
