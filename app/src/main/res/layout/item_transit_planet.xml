<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/glass_white_20"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_planet_card"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/planetName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Planet Name"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="@color/accent_gold"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/transitPosition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Transit Position"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/secondaryText" />

        <TextView
            android:id="@+id/natalHouseInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="Natal House Info"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="@color/accent_teal"
            android:textStyle="bold"
            tools:text="Transiting through Natal House 7" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
