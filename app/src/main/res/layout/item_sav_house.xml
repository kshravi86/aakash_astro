<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/glass_white_10"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/signName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                android:textColor="@color/primaryText"
                android:textStyle="bold"
                tools:text="Pisces" />

            <TextView
                android:id="@+id/houseBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_house_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="2dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="@color/accent_teal"
                android:textStyle="bold"
                tools:text="House 1" />

            <TextView
                android:id="@+id/signValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_value_chip_neutral"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/primaryText"
                android:textStyle="bold"
                tools:text="38" />
        </LinearLayout>

        <TextView
            android:id="@+id/valueHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="@color/secondaryText"
            tools:text="High Strength (Standout)" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/valueProgress"
            style="@style/Widget.Material3.LinearProgressIndicator"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="10dp"
            android:max="60"
            app:trackThickness="8dp"
            app:indicatorColor="@color/accent_teal"
            app:trackColor="@color/glass_white_5"
            app:trackCornerRadius="4dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>