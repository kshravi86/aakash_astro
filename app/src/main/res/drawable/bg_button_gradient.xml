<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#60000000">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="135"
                android:startColor="#FFF5C842"
                android:centerColor="#FFD9A45D"
                android:endColor="#FFED8E4A"
                android:type="linear" />
        </shape>
    </item>
    <!-- Shimmer highlight top -->
    <item android:bottom="26dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="#30FFFFFF"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
</ripple>
