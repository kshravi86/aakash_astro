<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:fitsSystemWindows="true"
        android:background="@android:color/transparent"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:contentScrim="?attr/colorSurface"
            app:expandedTitleGravity="bottom"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:statusBarScrim="?attr/colorSurface">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_collapseMode="parallax">

                <View
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="12dp"
                    android:alpha="0.85"
                    android:background="@drawable/bg_hero_glow" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/heroCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_margin="24dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="8dp"
                    app:strokeColor="@color/card_stroke_strong"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp"
                        android:gravity="center_horizontal"
                        android:background="@drawable/bg_hero_card">

                        <TextView
                            android:id="@+id/titleText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_name"
                            android:textAppearance="@style/TextAppearance.Material3.HeadlineLarge"
                            android:textStyle="bold"
                            android:textColor="@color/primaryText" />

                        <TextView
                            android:id="@+id/subtitleText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/hero_subtitle"
                            android:textAlignment="center"
                            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                            android:textColor="@color/secondaryText" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/engineIndicator"
                                style="@style/Widget.Material3.Chip.Suggestion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Engine"
                                android:textColor="@color/accent_teal"
                                app:chipIcon="@drawable/ic_dashboard_black_24dp"
                                app:chipIconTint="@color/accent_teal"
                                app:chipSurfaceColor="@color/glass_white_5"
                                app:chipStrokeColor="@color/glass_white_10"
                                app:chipStrokeWidth="1dp"
                                app:chipMinTouchTargetSize="0dp" />

                            <View
                                android:layout_width="12dp"
                                android:layout_height="0dp" />

                            <TextView
                                android:id="@+id/dateTimeValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_value_chip_neutral"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:text="No Selection"
                                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                                android:textColor="@color/primaryText" />
                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_gravity="center"
                                android:alpha="0.4"
                                android:background="@drawable/bg_hero_glow"
                                android:backgroundTint="@color/accent_gold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/generateButton"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_button_gradient"
                                app:backgroundTint="@android:color/transparent"
                                android:paddingVertical="12dp"
                                android:text="@string/generate_chart_cta"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/black"
                                app:cornerRadius="16dp"
                                app:icon="@drawable/ic_star_24"
                                app:iconGravity="textStart"
                                app:iconTint="@color/black" />
                        </FrameLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/topAppBar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/ic_home_black_24dp"
                app:subtitle="@string/toolbar_subtitle"
                app:subtitleTextColor="@color/secondaryText"
                app:title="@string/app_name"
                app:titleTextColor="@color/primaryText" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="40dp">

                        <TextView
                            android:id="@+id/sectionBirth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/birth_card_title"
                            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                            android:textColor="@color/accent_blue"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:letterSpacing="0.1" />
            
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardNatalProfile"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            app:cardBackgroundColor="@android:color/transparent"
                            app:cardCornerRadius="24dp"
                            app:cardElevation="4dp"
                            app:strokeColor="@color/glass_white_10"
                            app:strokeWidth="1dp">
            
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_glass_card"
                                android:orientation="vertical"
                                android:padding="20dp">
            
                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/nameInputLayout"
                                    style="@style/Widget.App.TextInputLayout"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="@string/hint_name_optional"
                                    app:boxBackgroundColor="@color/card_bg_elevated"
                                    app:boxStrokeColor="@color/card_stroke"
                                    app:boxStrokeWidth="1dp"
                                    app:boxStrokeWidthFocused="2dp"
                                    app:boxCornerRadiusTopStart="12dp"
                                    app:boxCornerRadiusTopEnd="12dp"
                                    app:boxCornerRadiusBottomStart="12dp"
                                    app:boxCornerRadiusBottomEnd="12dp">
            
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/nameInput"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:imeOptions="actionNext"
                                        android:inputType="textPersonName" />
                                </com.google.android.material.textfield.TextInputLayout>
            
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="16dp"
                                    android:orientation="horizontal">
            
                                    <com.google.android.material.textfield.TextInputLayout
                                        android:id="@+id/dateInputLayout"
                                        style="@style/Widget.App.TextInputLayout"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:hint="@string/label_birth_date"
                                        app:endIconDrawable="@drawable/ic_calendar_event_24"
                                        app:endIconMode="custom"
                                        app:boxBackgroundColor="@color/card_bg_elevated"
                                        app:boxStrokeColor="@color/card_stroke"
                                        app:boxCornerRadiusTopStart="12dp"
                                        app:boxCornerRadiusTopEnd="12dp"
                                        app:boxCornerRadiusBottomStart="12dp"
                                        app:boxCornerRadiusBottomEnd="12dp">
            
                                        <com.google.android.material.textfield.TextInputEditText
                                            android:id="@+id/dateInput"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:clickable="true"
                                            android:focusable="false"
                                            android:inputType="none" />
                                    </com.google.android.material.textfield.TextInputLayout>
            
                                    <Space
                                        android:layout_width="12dp"
                                        android:layout_height="wrap_content" />
            
                                    <com.google.android.material.textfield.TextInputLayout
                                        android:id="@+id/timeInputLayout"
                                        style="@style/Widget.App.TextInputLayout"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:hint="@string/label_birth_time"
                                        app:endIconDrawable="@drawable/ic_clock_outline_24"
                                        app:endIconMode="custom"
                                        app:boxBackgroundColor="@color/card_bg_elevated"
                                        app:boxStrokeColor="@color/card_stroke"
                                        app:boxCornerRadiusTopStart="12dp"
                                        app:boxCornerRadiusTopEnd="12dp"
                                        app:boxCornerRadiusBottomStart="12dp"
                                        app:boxCornerRadiusBottomEnd="12dp">
            
                                        <com.google.android.material.textfield.TextInputEditText
                                            android:id="@+id/timeInput"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:clickable="true"
                                            android:focusable="false"
                                            android:inputType="none" />
                                    </com.google.android.material.textfield.TextInputLayout>
                                </LinearLayout>
            
                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:layout_marginTop="20dp"
                                    android:background="@color/divider" />
            
                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/placeInputLayout"
                                    style="@style/Widget.App.TextInputLayout"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="20dp"
                                    android:hint="@string/hint_birth_place"
                                    app:boxBackgroundColor="@color/card_bg_elevated"
                                    app:boxStrokeColor="@color/accent_teal"
                                    app:boxCornerRadiusTopStart="12dp"
                                    app:boxCornerRadiusTopEnd="12dp"
                                    app:boxCornerRadiusBottomStart="12dp"
                                    app:boxCornerRadiusBottomEnd="12dp"
                                    app:startIconDrawable="@drawable/ic_place_24"
                                    app:startIconTint="@color/accent_teal">
            
                                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                        android:id="@+id/placeInput"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:imeOptions="actionDone"
                                        android:inputType="textCapWords" />
                                </com.google.android.material.textfield.TextInputLayout>
            
                                <TextView
                                    android:id="@+id/placeCoords"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                    android:textColor="@color/accent_teal"
                                    android:textStyle="bold"
                                    tools:text="12.9716° N, 77.5946° E" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:text="Quick Assist"
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                            android:textColor="@color/secondaryText"
                            android:textAllCaps="true"
                            android:letterSpacing="0.1" />
            
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/birthAssistCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            app:cardBackgroundColor="@android:color/transparent"
                            app:cardCornerRadius="24dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/glass_white_10"
                            app:strokeWidth="1dp">
            
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_glass_card"
                                android:orientation="vertical"
                                android:padding="16dp">
            
                                <HorizontalScrollView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:scrollbars="none">
                                    <com.google.android.material.chip.ChipGroup
                                        android:id="@+id/smartActionChips"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        app:singleLine="true">
                                        <com.google.android.material.chip.Chip
                                            android:id="@+id/chipSmartNow"
                                            style="@style/Widget.Material3.Chip.Assist"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Now"
                                            app:chipIcon="@drawable/ic_clock_outline_24"
                                            app:chipIconTint="@color/accent_teal"
                                            app:chipBackgroundColor="@color/glass_white_10"
                                            app:chipStrokeWidth="0dp" />
                                        <com.google.android.material.chip.Chip
                                            android:id="@+id/chipSmartLast"
                                            style="@style/Widget.Material3.Chip.Assist"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Last"
                                            app:chipIcon="@drawable/ic_history_24"
                                            app:chipIconTint="@color/accent_orange"
                                            app:chipBackgroundColor="@color/glass_white_10"
                                            app:chipStrokeWidth="0dp" />
                                    </com.google.android.material.chip.ChipGroup>
                                </HorizontalScrollView>
            
                                <HorizontalScrollView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:scrollbars="none">
                                    <com.google.android.material.chip.ChipGroup
                                        android:id="@+id/placeQuickChips"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        app:singleLine="true">
                                        <com.google.android.material.chip.Chip
                                            android:id="@+id/chipPlaceBengaluru"
                                            style="@style/Widget.Material3.Chip.Assist"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Bengaluru"
                                            app:chipBackgroundColor="@color/glass_white_10"
                                            app:chipStrokeWidth="0dp" />
                                        <com.google.android.material.chip.Chip
                                            android:id="@+id/chipPlaceDelhi"
                                            style="@style/Widget.Material3.Chip.Assist"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Delhi"
                                            app:chipBackgroundColor="@color/glass_white_10"
                                            app:chipStrokeWidth="0dp" />
                                        <com.google.android.material.chip.Chip
                                            android:id="@+id/chipPlaceMumbai"
                                            style="@style/Widget.Material3.Chip.Assist"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Mumbai"
                                            app:chipBackgroundColor="@color/glass_white_10"
                                            app:chipStrokeWidth="0dp" />
                                    </com.google.android.material.chip.ChipGroup>
                                </HorizontalScrollView>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
            <LinearLayout
                android:id="@+id/recentActionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recent_actions_title"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                    android:textColor="@color/accent_purple"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/recentActionChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingEnd="12dp"
                        app:singleLine="true" />
                </HorizontalScrollView>
            </LinearLayout>

            <TextView
                android:id="@+id/sectionChart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="@string/section_chart_title"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                android:textColor="@color/accent_gold"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1" />

            <com.aakash.astro.ui.VedicChartView
                android:id="@+id/vedicChartView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/actionsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="@string/actions_header"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                android:textColor="@color/accent_teal"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/actionGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="0dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <TextView
                android:id="@+id/sectionResults"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="@string/results_section_title"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                android:textColor="@color/accent_orange"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/planetCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="28dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/glass_white_10"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/planetContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="20dp" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="@color/brand_primary" />
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
