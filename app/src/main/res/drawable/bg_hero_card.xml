<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Rich dark base -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#FF07141E" />
        </shape>
    </item>

    <!-- Main gold-to-transparent diagonal -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="135"
                android:startColor="#80D9A45D"
                android:centerColor="#2012202B"
                android:endColor="#0007141E"
                android:type="linear" />
        </shape>
    </item>

    <!-- Shimmer overlay top-left -->
    <item android:bottom="64dp" android:right="64dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="135"
                android:startColor="#22FFFFFF"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>

    <!-- Bottom-right teal accent -->
    <item android:top="80dp" android:left="80dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="315"
                android:startColor="#1856CAB9"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>

    <!-- Border with gold tint -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke
                android:width="1.5dp"
                android:color="#50D9A45D" />
        </shape>
    </item>
</layer-list>
