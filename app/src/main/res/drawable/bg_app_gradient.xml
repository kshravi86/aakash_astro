<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/background_gradient_start"
                android:centerColor="@color/background_gradient_mid"
                android:endColor="@color/background_gradient_end"
                android:type="linear" />
        </shape>
    </item>

    <!-- Top-right gold glow (stronger) -->
    <item android:gravity="top|end">
        <shape android:shape="oval">
            <size
                android:width="420dp"
                android:height="420dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="240dp"
                android:startColor="#4AD9A45D"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>

    <!-- Bottom-left teal glow (stronger) -->
    <item
        android:gravity="bottom|start"
        android:top="180dp">
        <shape android:shape="oval">
            <size
                android:width="380dp"
                android:height="380dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="220dp"
                android:startColor="#3A56CAB9"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>

    <!-- Centre ambient purple haze -->
    <item android:gravity="center">
        <shape android:shape="oval">
            <size
                android:width="480dp"
                android:height="480dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="260dp"
                android:startColor="#12D284A7"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
