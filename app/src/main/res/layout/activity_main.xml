<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="336dp"
        android:background="@android:color/transparent"
        android:fitsSystemWindows="true"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:contentScrim="@color/card_bg"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:statusBarScrim="@color/card_bg">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_collapseMode="parallax">

                <View
                    android:layout_width="236dp"
                    android:layout_height="236dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="12dp"
                    android:alpha="0.94"
                    android:background="@drawable/bg_hero_glow" />

                <View
                    android:layout_width="188dp"
                    android:layout_height="188dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="72dp"
                    android:alpha="0.7"
                    android:background="@drawable/bg_hero_glow"
                    android:backgroundTint="@color/accent_teal" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/heroCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="10dp"
                    app:strokeColor="@color/glass_white_20"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_hero_card"
                        android:gravity="start"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="@string/hero_overline"
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                            android:textColor="@color/accent_gold"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/titleText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/app_name"
                            android:textAppearance="@style/TextAppearance.Material3.DisplaySmall"
                            android:textColor="@color/primaryText"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/subtitleText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:maxLines="3"
                            android:text="@string/hero_subtitle"
                            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                            android:textColor="@color/secondaryText" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                app:cardBackgroundColor="@color/glass_white_5"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:strokeColor="@color/glass_white_20"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:paddingHorizontal="14dp"
                                    android:paddingVertical="12dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/hero_engine_label"
                                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                                        android:textColor="@color/secondaryText" />

                                    <com.google.android.material.chip.Chip
                                        android:id="@+id/engineIndicator"
                                        style="@style/Widget.Material3.Chip.Suggestion"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:text="@string/engine_indicator_placeholder"
                                        android:textColor="@color/accent_gold"
                                        app:chipIcon="@drawable/ic_dashboard_black_24dp"
                                        app:chipIconTint="@color/accent_gold"
                                        app:chipMinTouchTargetSize="0dp"
                                        app:chipStrokeColor="@color/glass_white_20"
                                        app:chipStrokeWidth="1dp"
                                        app:chipSurfaceColor="@color/glass_white_5" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <Space
                                android:layout_width="12dp"
                                android:layout_height="wrap_content" />

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                app:cardBackgroundColor="@color/glass_white_5"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:strokeColor="@color/glass_white_20"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:paddingHorizontal="14dp"
                                    android:paddingVertical="12dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/date_time_summary_label"
                                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                                        android:textColor="@color/secondaryText" />

                                    <TextView
                                        android:id="@+id/dateTimeValue"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:maxLines="2"
                                        android:text="@string/date_time_summary_empty"
                                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                                        android:textColor="@color/primaryText" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:layout_gravity="center"
                                android:alpha="0.35"
                                android:background="@drawable/bg_hero_glow"
                                android:backgroundTint="@color/accent_gold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/generateButton"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_button_gradient"
                                android:paddingVertical="12dp"
                                android:text="@string/generate_chart_cta"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                app:backgroundTint="@android:color/transparent"
                                app:cornerRadius="16dp"
                                app:icon="@drawable/ic_star_24"
                                app:iconGravity="textStart"
                                app:iconTint="@color/black" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/hero_support"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="@color/secondaryText" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/topAppBar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/ic_home_black_24dp"
                app:subtitle="@string/toolbar_subtitle"
                app:subtitleTextColor="@color/secondaryText"
                app:title="@string/app_name"
                app:titleTextColor="@color/primaryText" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="40dp">

            <TextView
                android:id="@+id/sectionBirth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/birth_card_title"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                android:textColor="@color/accent_gold"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/birth_card_subtitle"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@color/secondaryText" />
             
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNatalProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="26dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/glass_white_20"
                app:strokeWidth="1dp">
            
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_glass_card"
                                android:orientation="vertical"
                                android:padding="20dp">
            
                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/nameInputLayout"
                                    style="@style/Widget.App.TextInputLayout"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="@string/hint_name_optional"
                                    app:boxBackgroundColor="@color/card_bg_elevated"
                                    app:boxStrokeColor="@color/card_stroke"
                                    app:boxStrokeWidth="1dp"
                                    app:boxStrokeWidthFocused="2dp"
                                    app:boxCornerRadiusTopStart="14dp"
                                    app:boxCornerRadiusTopEnd="14dp"
                                    app:boxCornerRadiusBottomStart="14dp"
                                    app:boxCornerRadiusBottomEnd="14dp">
            
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/nameInput"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:imeOptions="actionNext"
                                        android:inputType="textPersonName" />
                                </com.google.android.material.textfield.TextInputLayout>
            
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="16dp"
                                    android:orientation="horizontal">
            
                                    <com.google.android.material.textfield.TextInputLayout
                                        android:id="@+id/dateInputLayout"
                                        style="@style/Widget.App.TextInputLayout"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:hint="@string/label_birth_date"
                                        app:endIconDrawable="@drawable/ic_calendar_event_24"
                                        app:endIconMode="custom"
                                        app:boxBackgroundColor="@color/card_bg_elevated"
                                        app:boxStrokeColor="@color/card_stroke"
                                        app:boxCornerRadiusTopStart="14dp"
                                        app:boxCornerRadiusTopEnd="14dp"
                                        app:boxCornerRadiusBottomStart="14dp"
                                        app:boxCornerRadiusBottomEnd="14dp">
            
                                        <com.google.android.material.textfield.TextInputEditText
                                            android:id="@+id/dateInput"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:clickable="true"
                                            android:focusable="false"
                                            android:inputType="none" />
                                    </com.google.android.material.textfield.TextInputLayout>
            
                                    <Space
                                        android:layout_width="12dp"
                                        android:layout_height="wrap_content" />
            
                                    <com.google.android.material.textfield.TextInputLayout
                                        android:id="@+id/timeInputLayout"
                                        style="@style/Widget.App.TextInputLayout"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:hint="@string/label_birth_time"
                                        app:endIconDrawable="@drawable/ic_clock_outline_24"
                                        app:endIconMode="custom"
                                        app:boxBackgroundColor="@color/card_bg_elevated"
                                        app:boxStrokeColor="@color/card_stroke"
                                        app:boxCornerRadiusTopStart="14dp"
                                        app:boxCornerRadiusTopEnd="14dp"
                                        app:boxCornerRadiusBottomStart="14dp"
                                        app:boxCornerRadiusBottomEnd="14dp">
            
                                        <com.google.android.material.textfield.TextInputEditText
                                            android:id="@+id/timeInput"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:clickable="true"
                                            android:focusable="false"
                                            android:inputType="none" />
                                    </com.google.android.material.textfield.TextInputLayout>
                                </LinearLayout>
            
                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:layout_marginTop="20dp"
                                    android:background="@color/divider" />
            
                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/placeInputLayout"
                                    style="@style/Widget.App.TextInputLayout"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="20dp"
                                    android:hint="@string/hint_birth_place"
                                    app:boxBackgroundColor="@color/card_bg_elevated"
                                    app:boxStrokeColor="@color/accent_teal"
                                    app:boxCornerRadiusTopStart="14dp"
                                    app:boxCornerRadiusTopEnd="14dp"
                                    app:boxCornerRadiusBottomStart="14dp"
                                    app:boxCornerRadiusBottomEnd="14dp"
                                    app:startIconDrawable="@drawable/ic_place_24"
                                    app:startIconTint="@color/accent_teal">
            
                                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                        android:id="@+id/placeInput"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:imeOptions="actionDone"
                                        android:inputType="textCapWords" />
                                </com.google.android.material.textfield.TextInputLayout>
            
                                <TextView
                                    android:id="@+id/placeCoords"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                                    android:textColor="@color/accent_teal"
                                    android:textStyle="bold"
                                    tools:text="Bengaluru - 12.9716, 77.5946" />
                            </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/birthAssistCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/glass_white_20"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/birth_smart_actions_title"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/primaryText"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/quick_assist_subtitle"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/secondaryText" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/smartActionChips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleLine="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipSmartNow"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/birth_action_now"
                                android:textColor="@color/primaryText"
                                app:chipBackgroundColor="@color/glass_white_10"
                                app:chipIcon="@drawable/ic_clock_outline_24"
                                app:chipIconTint="@color/accent_teal"
                                app:chipStrokeWidth="0dp" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipSmartLast"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/birth_action_last"
                                android:textColor="@color/primaryText"
                                app:chipBackgroundColor="@color/glass_white_10"
                                app:chipIcon="@drawable/ic_history_24"
                                app:chipIconTint="@color/accent_gold"
                                app:chipStrokeWidth="0dp" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipSmartSample"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/birth_action_sample"
                                android:textColor="@color/primaryText"
                                app:chipBackgroundColor="@color/glass_white_10"
                                app:chipIcon="@drawable/ic_star_24"
                                app:chipIconTint="@color/accent_orange"
                                app:chipStrokeWidth="0dp" />
                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/place_quick_title"
                        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                        android:textColor="@color/secondaryText"
                        android:textStyle="bold" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/placeQuickChips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleLine="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipPlaceBengaluru"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/place_chip_bengaluru"
                                android:textColor="@color/primaryText"
                                app:chipBackgroundColor="@color/glass_white_10"
                                app:chipStrokeWidth="0dp" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipPlaceDelhi"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/place_chip_delhi"
                                android:textColor="@color/primaryText"
                                app:chipBackgroundColor="@color/glass_white_10"
                                app:chipStrokeWidth="0dp" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipPlaceMumbai"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/place_chip_mumbai"
                                android:textColor="@color/primaryText"
                                app:chipBackgroundColor="@color/glass_white_10"
                                app:chipStrokeWidth="0dp" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipPlaceChennai"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/place_chip_chennai"
                                android:textColor="@color/primaryText"
                                app:chipBackgroundColor="@color/glass_white_10"
                                app:chipStrokeWidth="0dp" />
                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:id="@+id/sectionChart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/section_chart_title"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                android:textColor="@color/accent_gold"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/chart_section_subtitle"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@color/secondaryText" />

            <com.aakash.astro.ui.VedicChartView
                android:id="@+id/vedicChartView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/sectionResults"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/results_section_title"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                android:textColor="@color/accent_teal"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/results_section_subtitle"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@color/secondaryText" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/planetCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="28dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/glass_white_20"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/planetContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="20dp" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/actionsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/actions_header"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                android:textColor="@color/accent_orange"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/actions_section_subtitle"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@color/secondaryText" />

            <LinearLayout
                android:id="@+id/recentActionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recent_actions_title"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="@color/primaryText"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/recent_actions_subtitle"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="@color/secondaryText" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/glass_white_20"
                    app:strokeWidth="1dp">

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_glass_card"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/recentActionChips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="14dp"
                            app:singleLine="true" />
                    </HorizontalScrollView>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/actionGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingBottom="4dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="@color/brand_primary" />
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
